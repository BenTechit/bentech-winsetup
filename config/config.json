      "serviceName": "ScreenConnect Client (b58e7c32699a96bf)" },
    "sevenZip": { "wingetId": "7zip.7zip" },
    "office": {
      "signer": "microsoft", "odtWingetId": "Microsoft.OfficeDeploymentTool",
      "odtSetupPath": "C:\\Program Files\\OfficeDeploymentTool\\setup.exe",
      "odtFallbackPage": "https://www.microsoft.com/en-us/download/details.aspx?id=49117",
      "odtLinkPattern": "https://download\\.microsoft\\.com/download/[^\"' ]+/officedeploymenttool_[0-9-]+\\.exe",
      "products": { "BUSINESS": "O365BusinessRetail", "HOME": "O365HomePremRetail" },
      "languages": ["he-il", "en-us"], "channel": "Current", "edition": "64",
      "excludeApps": ["Access", "Publisher", "Teams", "OneDrive", "Groove", "Lync", "Bing", "OutlookForWindows"]
    },
    "craft": {
      "signer": "craft",
      "items": [
        { "name": "WordCraft", "repo": "storytold/wordcraft", "assetPrefix": "wordcraft",
          "displayName": "^WordCraft", "startMenuName": "^WordCraft", "shortcut": "Word" },
        { "name": "GridCraft", "repo": "storytold/gridcraft", "assetPrefix": "gridcraft",
          "displayName": "^GridCraft", "startMenuName": "^GridCraft", "shortcut": "Excel" },
        { "name": "DeckCraft", "repo": "storytold/deckcraft", "assetPrefix": "deckcraft",
          "displayName": "^DeckCraft", "startMenuName": "^DeckCraft", "shortcut": "PowerPoint" },
        { "name": "PdfCraft", "repo": "storytold/pdfcraft", "assetPrefix": "pdfcraft",
