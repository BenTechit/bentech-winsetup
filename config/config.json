        { "name": "ArtCraft Launcher", "repo": "storytold/craft-launcher", "assetPrefix": "artcraft-launcher",
          "displayName": "^ArtCraft Launcher", "startMenuName": "^ArtCraft Launcher", "shortcut": "ArtCraft Launcher",
          "launcher": true }
      ]
